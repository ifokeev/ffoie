# Build artifacts — large; excluded so docker build context stays small.
/target
**/target
/dist

# Logs generated at runtime.
/logs

# Landing site and packaging — not needed by either docker build.
/website
/packaging
# Note: /web-client IS needed by engine-web's Dockerfile.web (trunk manifest);
# leaving it in context. It's tiny (one HTML file), so this doesn't bloat
# the chat-server build either.

# Debug logs, macOS kernel panics — repo reference only.
/debug

# CI/CD workflows — not part of the build.
/.github

# Git metadata and planning files — internal state; must not enter the image (T-05-01).
.git
/.planning

# macOS junk.
.DS_Store

# Editor swap files.
*.swp
*.swo
.idea/
.vscode/

# Env files that may contain secrets — NEVER embed in an image (T-05-01).
.env
.env.local

# Platform binaries.
*.pdb
*.exe

# k6 soak test output — not needed at build time.
soak-results.json
