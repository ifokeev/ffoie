# ffoie-chat-server environment variables
# Copy this file to .env and edit as needed.
# All variables are optional — the defaults work out-of-the-box.

# Address and port the server binds to.
FFOIE_CHAT_BIND=0.0.0.0:8080

# Message-of-the-day sent to every connecting client in the Welcome envelope.
FFOIE_CHAT_MOTD=Welcome to FFOIE chat — be excellent to each other

# WebSocket ping interval in seconds.
FFOIE_CHAT_HEARTBEAT_SECS=15

# Maximum size of a single chat message payload in bytes.
FFOIE_CHAT_MAX_MSG_BYTES=500

# Token-bucket burst capacity for per-connection rate limiting.
FFOIE_CHAT_RATE_BURST=10

# Token-bucket refill rate (tokens per second) for per-connection rate limiting.
FFOIE_CHAT_RATE_REFILL_PER_SEC=2

# Capacity of the internal tokio broadcast channel (power of 2 recommended).
FFOIE_CHAT_BROADCAST_CAPACITY=1024

# Number of recent messages kept in the in-memory scrollback ring.
FFOIE_CHAT_SCROLLBACK_SIZE=50

# Consecutive RecvError::Lagged events before a slow client is disconnected.
FFOIE_CHAT_MAX_LAG_DISCONNECTS=3

# Tracing log filter (see https://docs.rs/tracing-subscriber/latest/tracing_subscriber/filter/struct.EnvFilter.html)
RUST_LOG=ffoie_chat_server=info,tower_http=info

# Log format: "plain" (default) or "json" for structured logging.
RUST_LOG_FORMAT=plain
